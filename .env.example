# ─── App ───────────────────────────────────────────────
APP_NAME=ProofPay
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# ─── Database / Queue ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://proofpay:proofpay@localhost:5432/proofpay
DATABASE_URL_SYNC=postgresql://proofpay:proofpay@localhost:5432/proofpay
REDIS_URL=redis://localhost:6379/0

# ─── xAI / SpaceXAI ────────────────────────────────────
# https://console.x.ai → create API key (requires credits)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5
XAI_IMAGINE_IMAGE_MODEL=grok-imagine-image

# ─── X (Twitter) Developer App ─────────────────────────
# https://developer.x.com/en/portal/dashboard
# Enable OAuth 2.0; type: Web App (confidential client)
# Callback URL (local):  http://localhost:3000/api/auth/x/callback
# Callback URL (prod):   https://YOUR_DOMAIN/api/auth/x/callback
# Scopes used by ProofPay:
#   tweet.read tweet.write users.read offline.access media.write
# Optional: dm.read dm.write
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
# OAuth 1.0a app credentials (some webhook admin endpoints / media edges)
X_API_KEY=
X_API_SECRET=
# Comma-separated exact callback URLs registered in the X console
X_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write

# X Activity / webhooks (requires publicly reachable HTTPS URL)
X_WEBHOOK_ENV=dev
# Full public URL X will call, e.g. https://xxxx.ngrok.app/api/webhooks/x
X_WEBHOOK_URL=
# Consumer secret used for CRC HMAC (usually X_API_SECRET / client secret)
X_WEBHOOK_CRC_SECRET=

# ─── GitHub (optional, higher rate limits) ─────────────
GITHUB_TOKEN=

# ─── Evaluator ─────────────────────────────────────────
EVALUATOR_IMAGE=proofpay-evaluator:latest
EVALUATOR_TIMEOUT_SEC=600
EVALUATOR_MEMORY_MB=1024
EVALUATOR_CPUS=1.0
WORKSPACES_DIR=./workspaces
ARTIFACTS_DIR=./artifacts
# Set true only if Docker socket is available to the API/worker
EVALUATOR_DOCKER_ENABLED=true

# ─── Grok Build headless (optional P1) ─────────────────
GROK_CLI_PATH=grok
GROK_BUILD_ENABLED=false

# ─── Grok Reply App Bot (dedicated X account — NOT creator OAuth) ──
# See docs/REPLY_APP_BOT.md
# When someone @mentions the bot, Grok builds a mini-app and replies under the tweet.
REPLY_APP_BOT_ENABLED=false
REPLY_APP_BOT_X_USER_ID=
REPLY_APP_BOT_X_USERNAME=
REPLY_APP_BOT_ACCESS_TOKEN=
REPLY_APP_BOT_REFRESH_TOKEN=
REPLY_APP_ATTACH_PREVIEW_IMAGE=true
REPLY_APP_MAX_JOBS_PER_HOUR=30
REPLY_APP_REPLY_TEMPLATE=Built you a quick app for this → {url}
# Opportunity scanner: recent tweets from watchlist accounts
REPLY_APP_SCAN_ENABLED=true
REPLY_APP_SCAN_AUTO_REPLY=false
REPLY_APP_SCAN_MIN_SCORE=0.72
REPLY_APP_SCAN_MAX_TWEETS=40
REPLY_APP_SCAN_HOURS=24
# Comma-separated usernames without @
REPLY_APP_SCAN_ACCOUNTS=paulg,levelsio,swyx,jason,naval,pmarca,dhh,marc_louvion,steipete,t3dotgg,shadcn,vercel,linear
